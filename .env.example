# Copy to .env. Every variable here is optional — the app runs without any of
# them. See "Project status" in README.md for what degrades.

# ---- BROWSER-SAFE (VITE_ prefix = inlined into the bundle, public) ----
# WalletConnect Cloud project id. Project ids are public identifiers by design,
# so shipping this in the bundle is expected. Without it the connect modal
# offers injected wallets (MetaMask, Rabby, ...) only.
# Get one free at https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=

# Alchemy API key. Powers the three views that need an *index* — the ERC-20
# balance table, transfer history, and the NFT gallery. Nothing else needs it:
# wallet connect, native balance, sends, ENS and the contract console all run
# off public RPC. Without it those three views show a notice explaining why.
#
# ⚠️ This ships in the browser bundle, so SET A DOMAIN ALLOWLIST on the Alchemy
# app (Dashboard -> your app -> Security). That allowlist is the only thing
# stopping someone lifting the key out of the bundle and spending your quota.
# Covers Ethereum, Polygon and Sepolia — Alchemy has no BNB Chain support for
# these APIs, so those chains show the notice regardless.
# Get one free at https://dashboard.alchemy.com
VITE_ALCHEMY_API_KEY=

# ---- Moralis server credentials (swap layer only, awaiting migration) ----
# NOTE: Moralis discontinued hosted v1 servers. The app renders fine without
# these; only the /1inch swap page depends on them. See claude.md phase-2 plan.
REACT_APP_MORALIS_APPLICATION_ID=
REACT_APP_MORALIS_SERVER_URL=

# ---- Optional: only for the moralis-admin-cli local devchain workflow ----
# These are read by the CLI at the shell level and are never bundled into the
# app — no VITE_ prefix, so Vite cannot see them.
moralisApiKey=
moralisApiSecret=
frpcPath=
chain=local
moralisSubdomain=
abiPath=/absolute/path/to/Truffle/build/contracts/MetaCoin.json
