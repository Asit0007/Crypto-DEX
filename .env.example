# ---- Moralis server credentials (the app boots into onboarding without them) ----
# NOTE: Moralis discontinued hosted v1 servers — see "Project status" in README.md.
REACT_APP_MORALIS_APPLICATION_ID=your-moralis-app-id
REACT_APP_MORALIS_SERVER_URL=https://your-server.example.com:2053/server

# ---- Optional: only for the moralis-admin-cli local devchain workflow ----
# These are read by the CLI at the shell level and are never bundled into the app.
moralisApiKey=
moralisApiSecret=
frpcPath=
chain=local
moralisSubdomain=
abiPath=/absolute/path/to/Truffle/build/contracts/MetaCoin.json
